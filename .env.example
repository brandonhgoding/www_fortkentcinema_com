# Copy to .env for local development. Never commit real values.

# --- Core ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (SQLite unless USE_POSTGRES=True) ---
USE_POSTGRES=False
# DB_DB=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost

# --- Integrations ---
TMDB_API_KEY=
# Empty keeps analytics off outside production.
GA_MEASUREMENT_ID=

# --- Twilio phone line (phone app) ---
# Auth token from the Twilio console. Empty = every webhook returns 403.
TWILIO_AUTH_TOKEN=
# Account SID (AC...). Lets the dashboard play and delete recordings.
TWILIO_ACCOUNT_SID=
# Optional: the public base URL Twilio calls, e.g. https://abc123.ngrok-free.app
# or https://www.fortkentcinema.com. Signatures are checked against this
# instead of the URL rebuilt from proxy headers.
TWILIO_WEBHOOK_BASE_URL=

# --- Production only (behind nginx) ---
# USE_PROXY_HEADERS=True
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://www.fortkentcinema.com
# SECURE_HSTS_SECONDS=31536000
# MEDIA_ROOT=/path/to/shared/media
